static void Gas_Display_Task(uint32_t now);
static void RFID_Task(uint32_t now);
static void Door_IR_Task(uint32_t now);

static void Servo_SetAngle(TIM_HandleTypeDef *timer, uint32_t channel, uint8_t angle)
{
    if (angle > 180U) angle = 180U;
    uint32_t pulse = SERVO_MIN_US +
        ((uint32_t)angle * (SERVO_MAX_US - SERVO_MIN_US)) / 180U;
    __HAL_TIM_SET_COMPARE(timer, channel, pulse);
}

int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_I2C1_Init();
    MX_SPI1_Init();
    MX_ADC1_Init();
    MX_TIM1_Init();
    MX_TIM2_Init();
    MX_TIM3_Init();
    MX_TIM4_Init();

    if (HAL_ADCEx_Calibration_Start(&hadc1) != HAL_OK) Error_Handler();
    if (RTC_HSE128_Init() != HAL_OK) Error_Handler();
    DHT11_Init();

    const ClockDateTime initial = { 2026, 11, 9, 12, 30, 0 };
    if (ClockRTC_Init(&initial) != HAL_OK) Error_Handler();
#if FORCE_SET_TIME
    if (ClockRTC_Set(&initial) != HAL_OK) Error_Handler();
#endif

    if (LCD1602_Init(&hi2c1) != HAL_OK) Error_Handler();

    /* User-defined 5x8 rain/cloud icon stored at LCD CGRAM slot 1.
     * Choose slot 1 (not slot 0) because line text is a C string. */
    /* Cloud + rain, LCD1602 custom character 5 x 8. */
    const uint8_t rain_icon[8] = {
        0b01110, /*  ###  */
        0b10001, /* #   # */
        0b11111, /* ##### */
        0b00000, /*       */
        0b10101, /* # # # */
        0b10101, /* # # # */
        0b00000, /*       */
        0b10101  /* # # # */
    };
    LCD1602_CreateChar(1U, rain_icon);
    app.display_dirty = 1U;

    /* Use existing fan.c configured for TIM3_CH1 PB4 and GPIO PB11 LOW. */
    if (Fan_Init() != HAL_OK) Error_Handler();
    Fan_SetDuty(0U);

    /* Both servos: 50 Hz timer, 1 us tick. */
    if (HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1) != HAL_OK) Error_Handler();
    if (HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1) != HAL_OK) Error_Handler();
    Servo_SetAngle(&htim1, TIM_CHANNEL_1, DOOR_CLOSE_ANGLE);
    Servo_SetAngle(&htim2, TIM_CHANNEL_1, ROOF_CLOSE_ANGLE);

    MFRC522_Init();
    GasApp_Init();
    Lamp_Task(HAL_GetTick());

    while (1) {
        uint32_t now = HAL_GetTick();
        Lamp_Task(now);
        RFID_Task(now);
        Door_IR_Task(now);
        Rain_Task(now);
        /* ADC1_IN9 restored by Rain_ReadWetness before gas task. */
        GasApp_Task();
        /* Read gas PB1 after GasApp_Task; ADC is shared with rain sensor. */
        Gas_Display_Task(now);
        Button_Task(now);
        DHT_Task(now);
        Fan_Task(now, app.temperature, app.sensor_valid);
        Display_Task(now);
    }
}

static void Button_Task(uint32_t now)
{
    static GPIO_PinState last_sample = GPIO_PIN_SET;
    static GPIO_PinState stable = GPIO_PIN_SET;
    static uint32_t last_change = 0U;
    GPIO_PinState sample = HAL_GPIO_ReadPin(BUTTON_PORT, BUTTON_PIN);
    if (sample != last_sample) { last_sample = sample; last_change = now; }
    if ((uint32_t)(now - last_change) >= BUTTON_DEBOUNCE_MS && sample != stable) {
        stable = sample;
        if (stable == GPIO_PIN_RESET) {
            app.screen = (app.screen == SCREEN_CLOCK) ? SCREEN_SENSOR : SCREEN_CLOCK;
            app.display_dirty = 1U;
        }
    }
}

static void DHT_Task(uint32_t now)
{
    static uint32_t last_ms = 0U;
    uint8_t temp, hum;
    if ((uint32_t)(now - last_ms) < DHT_PERIOD_MS) return;
    last_ms = now;
    if (DHT11_Read(&temp, &hum) == HAL_OK) {
        if (!app.sensor_valid || temp != app.temperature || hum != app.humidity)
            app.display_dirty = 1U;
        app.temperature = temp;
        app.humidity = hum;
        app.sensor_valid = 1U;
    } else {
        if (app.sensor_valid) app.display_dirty = 1U;
        app.sensor_valid = 0U;
    }
}

static void Lamp_Task(uint32_t now)
{
    static uint32_t last_ms = 0U;
    static uint8_t first = 1U;
    ClockDateTime t;
    if (!first && (uint32_t)(now - last_ms) < LAMP_PERIOD_MS) return;
    first = 0U;
    last_ms = now;
    if (ClockRTC_Get(&t) != HAL_OK || t.hour >= 24U) {
        HAL_GPIO_WritePin(LAMP_PORT, LAMP_PIN, GPIO_PIN_RESET);
        return;
    }
    HAL_GPIO_WritePin(LAMP_PORT, LAMP_PIN,
        (t.hour >= 17U || t.hour < 5U) ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

static void Display_Task(uint32_t now)
{
    static uint32_t last_poll = 0U;
    static char old1[17] = "";
    static char old2[17] = "";
    char line1[17] = {0}, line2[17] = {0};
    if (!app.display_dirty && (uint32_t)(now - last_poll) < LCD_POLL_MS) return;
    last_poll = now;
    /* 1. GAS warning always overrides every other screen until normal. */
    /* 2. Timed RFID/rain notifications, 3. ordinary RTC/DHT11 screen. */
    if (notice != NOTICE_NONE) {
        uint32_t duration = (notice == NOTICE_RAIN)
                          ? RAIN_NOTICE_MS : LCD_NOTICE_MS;
        if ((uint32_t)(now - notice_started_ms) >= duration) {
            notice = NOTICE_NONE;
            app.display_dirty = 1U;
        }
    }
    if (gas_level_debug >= 2U) {
        snprintf(line1, sizeof(line1), "GAS: LEVEL 2");
        snprintf(line2, sizeof(line2), "ADC:%4u DANGER", (unsigned)gas_adc_debug);
    } else if (gas_level_debug == 1U) {
        snprintf(line1, sizeof(line1), "GAS: LEVEL 1");
        snprintf(line2, sizeof(line2), "ADC:%4u ALERT", (unsigned)gas_adc_debug);
    } else if (notice != NOTICE_NONE) {
        switch (notice) {
        case NOTICE_RAIN:
            snprintf(line1, sizeof(line1), "RAIN: DETECTED");
            snprintf(line2, sizeof(line2), "ROOF: OPENING");
            break;
        case NOTICE_DRY:
            snprintf(line1, sizeof(line1), "RAIN: STOPPED");
            snprintf(line2, sizeof(line2), "ROOF: CLOSING");
            break;
        case NOTICE_DOOR_OPEN:
            snprintf(line1, sizeof(line1), "%s", door_trip_entry ? "ACCESS: ENTRY" : "ACCESS: EXIT");
            snprintf(line2, sizeof(line2), "DOOR: OPEN");
            break;
        case NOTICE_DOOR_CLOSE:
            snprintf(line1, sizeof(line1), "DOOR: CLOSED");
            snprintf(line2, sizeof(line2), "%s", door_trip_entry ? "ENTRY COMPLETE" : "EXIT COMPLETE");
            break;
        default:
            break;
        }
    } else if (app.screen == SCREEN_CLOCK) {
        ClockDateTime t;
        if (ClockRTC_Get(&t) == HAL_OK) {
            snprintf(line1, sizeof(line1), "TIME: %02u:%02u:%02u",
                (unsigned)(t.hour % 24U), (unsigned)(t.minute % 60U),
                (unsigned)(t.second % 60U));
            snprintf(line2, sizeof(line2), "DATE: %02u/%02u/%04u",
                (unsigned)(t.day % 100U), (unsigned)(t.month % 100U),
                (unsigned)(t.year % 10000U));
        } else {
            snprintf(line1, sizeof(line1), "RTC ERROR");
            snprintf(line2, sizeof(line2), "CHECK RTC");
        }
    } else if (app.sensor_valid) {
        snprintf(line1, sizeof(line1), "TEMP: %u C", (unsigned)app.temperature);
        snprintf(line2, sizeof(line2), "HUM : %u %%", (unsigned)app.humidity);
    } else {
        snprintf(line1, sizeof(line1), "DHT11 NO DATA");
        snprintf(line2, sizeof(line2), "CHECK PA10");
    }
    /* RAIN at row 1, col 12..15; rain icon at row 2, col 13.
     * Only add to the ordinary sensor screen. Never overwrite gas alert.
     * Clearing the strings on subsequent renders clears both when dry. */
    if (gas_level_debug == 0U && notice == NOTICE_NONE &&
        app.screen == SCREEN_SENSOR && raining) {
        size_t len1 = strlen(line1);
        size_t len2 = strlen(line2);
        for (size_t i = len1; i < 12U; ++i) line1[i] = ' ';
        line1[12] = 'R';
        line1[13] = 'A';
        line1[14] = 'I';
        line1[15] = 'N';
        line1[16] = '\0';

        for (size_t i = len2; i < 13U; ++i) line2[i] = ' ';
        line2[13] = RAIN_ICON_CHAR;
        line2[14] = ' ';
        line2[15] = ' ';
        line2[16] = '\0';
    }

    if (strcmp(line1, old1) != 0) {
        LCD1602_WriteLine(0, line1);
        strcpy(old1, line1);
    }
    if (strcmp(line2, old2) != 0) {
        LCD1602_WriteLine(1, line2);
        strcpy(old2, line2);
    }
    app.display_dirty = 0U;
}

/* Update LCD warning level from gas ADC1_IN9, without slowing gas_app task.
 * IMPORTANT: gas_app.c alarm thresholds must be changed there too.
 * This polling method assumes gas_app uses the shared ADC in blocking mode.
 */
static void Gas_Display_Task(uint32_t now)
{
    static uint32_t last_sample = 0U;
    ADC_ChannelConfTypeDef ch = {0};
    uint16_t raw;
    uint8_t next;

    if ((uint32_t)(now - last_sample) < GAS_LCD_SAMPLE_MS) return;
    last_sample = now;

    ch.Channel = ADC_CHANNEL_9;  /* PB1, MQ2 AO */
    ch.Rank = ADC_REGULAR_RANK_1;
    ch.SamplingTime = ADC_SAMPLETIME_239CYCLES_5;
    if (HAL_ADC_ConfigChannel(&hadc1, &ch) != HAL_OK) return;
    if (HAL_ADC_Start(&hadc1) != HAL_OK) return;
    if (HAL_ADC_PollForConversion(&hadc1, 5U) != HAL_OK) {
        HAL_ADC_Stop(&hadc1);
        return;
    }

    raw = (uint16_t)HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);
    gas_adc_debug = raw;

    /* Hysteresis: raise level immediately; lower only below release threshold. */
    next = gas_level_debug;
    if (raw >= GAS_LEVEL2_ON) {
        next = 2U;
    } else if (raw >= GAS_LEVEL1_ON) {
        if (next == 2U && raw >= GAS_LEVEL2_OFF) next = 2U;
        else next = 1U;
    } else {
        if (next == 2U && raw >= GAS_LEVEL2_OFF) next = 2U;
        else if (next >= 1U && raw >= GAS_LEVEL1_OFF) next = 1U;
        else next = 0U;
    }
    if (next != gas_level_debug) {
        gas_level_debug = next;
        app.display_dirty = 1U;
    }
}

/* Read 8 ADC samples, invert if sensor's AO decreases when wet. */
static uint16_t Rain_ReadWetness(void)
{
    static uint16_t last_wetness = 0U;
    uint32_t sum = 0U;
    uint8_t count = 0U;
    ADC_ChannelConfTypeDef adc_ch = {0};
    adc_ch.Channel = ADC_CHANNEL_1;
    adc_ch.Rank = ADC_REGULAR_RANK_1;
    adc_ch.SamplingTime = ADC_SAMPLETIME_239CYCLES_5;
    /* Rain reads PA1. ADC1 shared with gas (PB1). */
    if (HAL_ADC_ConfigChannel(&hadc1, &adc_ch) != HAL_OK)
        return last_wetness;
    for (uint8_t i = 0U; i < 8U; ++i) {
        if (HAL_ADC_Start(&hadc1) != HAL_OK) break;
        if (HAL_ADC_PollForConversion(&hadc1, 5U) == HAL_OK) {
            sum += HAL_ADC_GetValue(&hadc1);
            count++;
        }
        HAL_ADC_Stop(&hadc1);
    }
    if (count != 0U) {
        uint16_t raw = (uint16_t)(sum / count);
#if RAIN_SENSOR_INVERT
        last_wetness = (uint16_t)(4095U - raw);
#else
        last_wetness = raw;
#endif
    }
    /* Restore PB1 ADC1_IN9 for GasApp_Task().
     * This works when both apps use ADC polling sequentially.
     * If GasApp uses DMA/interrupt ADC, coordination in gas_app.c is required. */
    adc_ch.Channel = ADC_CHANNEL_9;
    if (HAL_ADC_ConfigChannel(&hadc1, &adc_ch) != HAL_OK)
        Error_Handler();
    return last_wetness;
}

static void Rain_Task(uint32_t now)
{
    static uint32_t last_sample = 0U;
    static uint32_t wet_since = 0U;
    static uint32_t dry_since = 0U;
    static uint8_t wet_counting = 0U, dry_counting = 0U;
    static uint32_t last_step = 0U;

    if ((uint32_t)(now - last_sample) >= RAIN_SAMPLE_MS) {
        last_sample = now;
        uint16_t wetness = Rain_ReadWetness();

        if (wetness >= RAIN_ON_THRESHOLD) {
            dry_counting = 0U;
            if (!wet_counting) { wet_counting = 1U; wet_since = now; }
            else if (!raining && (uint32_t)(now - wet_since) >= RAIN_CONFIRM_MS) {
                raining = 1U;
                roof_target = ROOF_OPEN_ANGLE;
                /* After the 5 s rain message, stay on Temp/Humidity. */
                app.screen = SCREEN_SENSOR;
                LCD_Notify(NOTICE_RAIN, now);
            }
        } else {
            wet_counting = 0U;
        }
        if (wetness <= RAIN_OFF_THRESHOLD) {
            wet_counting = 0U;
            if (!dry_counting) { dry_counting = 1U; dry_since = now; }
            else if (raining && (uint32_t)(now - dry_since) >= DRY_CONFIRM_MS) {
                raining = 0U;
                roof_target = ROOF_CLOSE_ANGLE;
                LCD_Notify(NOTICE_DRY, now);
            }
        } else {
            dry_counting = 0U;
        }
    }

    if (roof_angle != roof_target &&
        (uint32_t)(now - last_step) >= SERVO_STEP_MS) {
        last_step = now;
        if (roof_angle < roof_target) roof_angle++;
        else roof_angle--;
        Servo_SetAngle(&htim2, TIM_CHANNEL_1, roof_angle);
    }
}

/* UID from the supplied RFID door example (4-byte UID only). */
static const uint8_t allowed_uid[4] = {0x5CU, 0x08U, 0x41U, 0x12U};

static void RFID_Task(uint32_t now)
{
    static uint32_t last_poll = 0U;
    static uint8_t card_latched = 0U;
    static uint8_t no_card_count = 0U;
    uint8_t buffer[MAX_LEN] = {0};

    if ((uint32_t)(now - last_poll) < RFID_PERIOD_MS) return;
    last_poll = now;

    /* Try to see an IDLE or HALTed tag. */
    if (MFRC522_Request(PICC_REQALL, buffer) != MI_OK) {
        if (no_card_count < 3U) no_card_count++;
        if (no_card_count >= 3U) card_latched = 0U;
        return;
    }

    no_card_count = 0U;
    if (card_latched) return;
    if (MFRC522_Anticoll(buffer) != MI_OK) return;
    card_latched = 1U;

    if (memcmp(buffer, allowed_uid, 4U) == 0 && !door_open) {
        /* Direction alternates only after a completed, sensed passage. */
        door_trip_entry = door_next_entry;
        door_direction_debug = door_trip_entry ? 1U : 2U;
        door_pass_detected = 0U;
        door_clear_counting = 0U;
        door_clear_since = 0U;
        door_open = 1U;
        Servo_SetAngle(&htim1, TIM_CHANNEL_1, DOOR_OPEN_ANGLE);
        LCD_Notify(NOTICE_DOOR_OPEN, now);
    }
    /* Do not call MFRC522_Halt: it is absent from user's rc522 library. */
}

/*
 * IR: OUT LOW when obstacle detected (verify with Live Expressions).
 * After a valid RFID scan, keep door open for as long as IR sees a person.
 * Once the person has been seen AND leaves IR area, wait 3 s then close.
 * No HAL_Delay(): other modules continue servicing gas, rain, LCD, etc.
 */
static void Door_IR_Task(uint32_t now)
{
    static GPIO_PinState previous_raw = GPIO_PIN_SET;
    static GPIO_PinState stable_raw = GPIO_PIN_SET;
    static uint32_t changed_at = 0U;
    GPIO_PinState raw = HAL_GPIO_ReadPin(DOOR_IR_PORT, DOOR_IR_PIN);

    if (raw != previous_raw) {
        previous_raw = raw;
        changed_at = now;
    }
    if ((uint32_t)(now - changed_at) >= DOOR_IR_DEBOUNCE_MS)
        stable_raw = raw;

    door_ir_debug = (stable_raw == DOOR_IR_ACTIVE) ? 1U : 0U;

    if (!door_open) return;

    if (door_ir_debug) {
        door_pass_detected = 1U;
        door_clear_counting = 0U; /* person still present -> stay open */
        return;
    }

    /* Do not auto-close until at least one real sensor detection occurred. */
    if (!door_pass_detected) return;

    if (!door_clear_counting) {
        door_clear_counting = 1U;
        door_clear_since = now;
        return;
    }

    if ((uint32_t)(now - door_clear_since) >= DOOR_IR_CLEAR_MS) {
        door_open = 0U;
        door_clear_counting = 0U;
        door_pass_detected = 0U;
        Servo_SetAngle(&htim1, TIM_CHANNEL_1, DOOR_CLOSE_ANGLE);
        door_next_entry = !door_next_entry;
        door_completed_debug++;
        LCD_Notify(NOTICE_DOOR_CLOSE, now);
    }
}

void SystemClock_Config(void)
{
    RCC_OscInitTypeDef osc = {0};
    RCC_ClkInitTypeDef clk = {0};
    osc.OscillatorType = RCC_OSCILLATORTYPE_HSE;
    osc.HSEState = RCC_HSE_ON;
    osc.PLL.PLLState = RCC_PLL_ON;
    osc.PLL.PLLSource = RCC_PLLSOURCE_HSE;
    osc.PLL.PLLMUL = RCC_PLL_MUL9;
    if (HAL_RCC_OscConfig(&osc) != HAL_OK) Error_Handler();

    clk.ClockType = RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_SYSCLK |
                    RCC_CLOCKTYPE_PCLK1 | RCC_CLOCKTYPE_PCLK2;
    clk.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
    clk.AHBCLKDivider = RCC_SYSCLK_DIV1;
    clk.APB1CLKDivider = RCC_HCLK_DIV2;
    clk.APB2CLKDivider = RCC_HCLK_DIV1;
    if (HAL_RCC_ClockConfig(&clk, FLASH_LATENCY_2) != HAL_OK) Error_Handler();

    /* ADC1 <= 14 MHz: 72 / 6 = 12 MHz. */
    __HAL_RCC_ADC_CONFIG(RCC_ADCPCLK2_DIV6);
}

static HAL_StatusTypeDef RTC_HSE128_Init(void)
{
    uint32_t start, prl;
    __HAL_RCC_PWR_CLK_ENABLE();
    __HAL_RCC_BKP_CLK_ENABLE();
    HAL_PWR_EnableBkUpAccess();
    if ((RCC->BDCR & RCC_BDCR_RTCSEL) != RCC_RTCCLKSOURCE_HSE_DIV128) {
        __HAL_RCC_BACKUPRESET_FORCE();
        __HAL_RCC_BACKUPRESET_RELEASE();
        HAL_PWR_EnableBkUpAccess();
    }
    __HAL_RCC_RTC_CONFIG(RCC_RTCCLKSOURCE_HSE_DIV128);
    __HAL_RCC_RTC_ENABLE();
    HAL_PWR_EnableBkUpAccess();
    CLEAR_BIT(RTC->CRL, RTC_CRL_RSF);
    start = HAL_GetTick();
    while ((RTC->CRL & RTC_CRL_RSF) == 0U)
        if ((uint32_t)(HAL_GetTick() - start) > 2000U) return HAL_TIMEOUT;
    start = HAL_GetTick();
    while ((RTC->CRL & RTC_CRL_RTOFF) == 0U)
        if ((uint32_t)(HAL_GetTick() - start) > 2000U) return HAL_TIMEOUT;
    prl = ((uint32_t)(RTC->PRLH & 0x0FU) << 16) | RTC->PRLL;
    if (prl != 62499U) {
        SET_BIT(RTC->CRL, RTC_CRL_CNF);
        RTC->PRLH = 0U;
        RTC->PRLL = 62499U;
        CLEAR_BIT(RTC->CRL, RTC_CRL_CNF);
        start = HAL_GetTick();
        while ((RTC->CRL & RTC_CRL_RTOFF) == 0U)
            if ((uint32_t)(HAL_GetTick() - start) > 2000U) return HAL_TIMEOUT;
    }
    return HAL_OK;
}

