/* STM32F103C8T6 - integrated smart home
 * LCD I2C1: PB8 SCL PB9 SDA (remap), address from existing library
 * DHT11: PA10; Screen button: PA12 (active-low)
 * RTC lamp: PA11 (17:00 to 05:00)
 * Fan L9110S: PB4 TIM3_CH1 PWM -> IA; PB11 GPIO LOW -> IB
 * RC522 SPI1: PA4 CS, PA5 SCK, PA6 MISO, PA7 MOSI, PB0 RST
 * Door servo: PA8 TIM1_CH1; IR obstacle sensor OUT: PA3 (active-low)
 * Rain sensor AO: PA1 ADC1_IN1; roof servo: PA0 TIM2_CH1
 * Gas: PB1 ADC1_IN9; PB6 TIM4_CH1; GPIO PB5, PB7, PB12..PB15; EXTI PC13, PC14.
 * SYSCLK 72 MHz; RTC HSE/128.
 */
#include "main.h"
#include "clock_rtc.h"
#include "dht11.h"
#include "lcd1602_i2c.h"
#include "fan.h"
#include "rc522.h"
#include "gas_app.h"
#include <stdint.h>
#include <stdio.h>
#include <string.h>

#define FORCE_SET_TIME       1
#define BUTTON_DEBOUNCE_MS   30U
#define DHT_PERIOD_MS        2000U
#define LCD_POLL_MS          100U
#define LAMP_PERIOD_MS       1000U
#define RFID_PERIOD_MS       150U
#define LCD_NOTICE_MS        3000U
#define RAIN_NOTICE_MS       5000U
#define RAIN_ICON_CHAR       ((char)1)
/* ADC thresholds for LCD alerts. Match gas_app.c hardware alarms separately. */
#define GAS_LEVEL1_ON        800U
#define GAS_LEVEL2_ON        2000U
#define GAS_LEVEL1_OFF       750U
#define GAS_LEVEL2_OFF       1900U
#define GAS_LCD_SAMPLE_MS    100U
#define RAIN_SAMPLE_MS       50U
#define RAIN_ON_THRESHOLD    2200U
#define RAIN_OFF_THRESHOLD   1600U
#define RAIN_CONFIRM_MS      1500U
#define DRY_CONFIRM_MS       10000U
#define RAIN_SENSOR_INVERT   1U
#define SERVO_STEP_MS        15U
#define SERVO_MIN_US         500U
#define SERVO_MAX_US         2500U
#define ROOF_OPEN_ANGLE      180U
#define ROOF_CLOSE_ANGLE     0U
#define DOOR_OPEN_ANGLE      130U
#define DOOR_CLOSE_ANGLE     0U
#define DOOR_IR_CLEAR_MS      3000U  /* close 3s after person leaves */
#define DOOR_IR_DEBOUNCE_MS   50U    /* filter brief IR noise */
#define DOOR_IR_ACTIVE        GPIO_PIN_RESET /* typical MH sensor OUT LOW */

#define BUTTON_PORT GPIOA
#define BUTTON_PIN GPIO_PIN_12
#define LAMP_PORT GPIOA
#define LAMP_PIN GPIO_PIN_11
#define DOOR_IR_PORT GPIOA
#define DOOR_IR_PIN GPIO_PIN_3

I2C_HandleTypeDef hi2c1;
SPI_HandleTypeDef hspi1; /* rc522.c expects this exact global */
ADC_HandleTypeDef hadc1;
TIM_HandleTypeDef htim1; /* Door servo: PA8 */
TIM_HandleTypeDef htim2; /* Rain servo: PA0 */
TIM_HandleTypeDef htim3; /* Fan: PB4 */
TIM_HandleTypeDef htim4; /* Gas app: PB6 TIM4_CH1 */

typedef enum { SCREEN_CLOCK = 0, SCREEN_SENSOR = 1 } ScreenMode;
typedef struct {
    ScreenMode screen;
    uint8_t temperature, humidity, sensor_valid, display_dirty;
} AppState;
static AppState app = { SCREEN_CLOCK, 0U, 0U, 0U, 1U };

static uint8_t roof_angle = ROOF_CLOSE_ANGLE;
static uint8_t roof_target = ROOF_CLOSE_ANGLE;
static uint8_t raining = 0U;
static uint8_t door_open = 0U;
/* One currently authorized UID. For several cards, store next direction per UID. */
static uint8_t door_next_entry = 1U; /* 1=IN, 0=OUT */
static uint8_t door_trip_entry = 1U;
static uint8_t door_pass_detected = 0U;
static uint32_t door_clear_since = 0U;
static uint8_t door_clear_counting = 0U;
/* Live Expressions: 1=object detected, 0=clear; direction 1=IN/2=OUT. */
volatile uint8_t door_ir_debug = 0U;
volatile uint8_t door_direction_debug = 0U;
volatile uint32_t door_completed_debug = 0U;
/* Watch in STM32CubeIDE Live Expressions. */
volatile uint16_t gas_adc_debug = 0U;
volatile uint8_t gas_level_debug = 0U; /* 0 = normal, 1 = warning, 2 = danger */

typedef enum {
    NOTICE_NONE = 0,
    NOTICE_RAIN,
    NOTICE_DRY,
    NOTICE_DOOR_OPEN,
    NOTICE_DOOR_CLOSE
} NoticeType;
static NoticeType notice = NOTICE_NONE;
static uint32_t notice_started_ms = 0U;

static void LCD_Notify(NoticeType type, uint32_t now)
{
    notice = type;
    notice_started_ms = now;
    app.display_dirty = 1U;
}

