#include "main.h"
#include "clock_rtc.h"
#include "dht11.h"
#include "lcd1602_i2c.h"
#include "fan.h"

#include <stdint.h>
#include <stdio.h>
#include <string.h>

/* STM32F103C8T6, HSE 8 MHz, SYSCLK 72 MHz.
 * I2C1: PB8=SCL, PB9=SDA (remap)
 * DHT11: PA10, button: PA12 (active LOW), lamp: PA11 (active HIGH)
 * L9110S: PB10=IA (TIM2_CH3 PWM), PB11=IB (LOW)
 * TIM3_CH1: PB4 (partial remap), initialized but not started
 * RTC: HSE/128, prescaler 62499
 */
#define FORCE_SET_TIME       0
#define BUTTON_DEBOUNCE_MS   30U
#define DHT_PERIOD_MS        2000U
#define LCD_POLL_MS          100U
#define LAMP_PERIOD_MS       1000U

#define BUTTON_PORT GPIOA
#define BUTTON_PIN  GPIO_PIN_12
#define LAMP_PORT   GPIOA
#define LAMP_PIN    GPIO_PIN_11

I2C_HandleTypeDef hi2c1;
TIM_HandleTypeDef htim2;
TIM_HandleTypeDef htim3;

typedef enum { SCREEN_CLOCK = 0, SCREEN_SENSOR = 1 } ScreenMode;
typedef struct {
    ScreenMode screen;
    uint8_t temperature;
    uint8_t humidity;
    uint8_t sensor_valid;
    uint8_t display_dirty;
} AppState;
static AppState app = {SCREEN_CLOCK, 0U, 0U, 0U, 1U};

void SystemClock_Config(void);
void Error_Handler(void);
static void MX_GPIO_Init(void);
static void MX_I2C1_Init(void);
static void MX_TIM2_Init(void);
static void MX_TIM3_Init(void);
static HAL_StatusTypeDef RTC_HSE128_Init(void);
static void Button_Task(uint32_t now);
static void DHT_Task(uint32_t now);
static void Lamp_Task(uint32_t now);
static void Display_Task(uint32_t now);

int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_I2C1_Init();
    MX_TIM2_Init();
    MX_TIM3_Init();

    if (RTC_HSE128_Init() != HAL_OK) Error_Handler();
    DHT11_Init();

    /* Year, month, day, hour, minute, second */
    const ClockDateTime initial = {2026, 11, 9, 17, 30, 0};
    if (ClockRTC_Init(&initial) != HAL_OK) Error_Handler();
#if FORCE_SET_TIME
    if (ClockRTC_Set(&initial) != HAL_OK) Error_Handler();
#endif

    if (LCD1602_Init(&hi2c1) != HAL_OK) Error_Handler();
    app.display_dirty = 1U;

    /* fan.c must use htim2, TIM_CHANNEL_3, PB11 LOW */
    if (Fan_Init() != HAL_OK) Error_Handler();
    Fan_SetDuty(0U);

    Lamp_Task(HAL_GetTick());
    while (1) {
        uint32_t now = HAL_GetTick();
        Lamp_Task(now);
        Button_Task(now);
        DHT_Task(now);
        Fan_Task(now, app.temperature, app.sensor_valid);
        Display_Task(now);
    }
}

static void Button_Task(uint32_t now)
{
    static GPIO_PinState last_sample = GPIO_PIN_SET;
    static GPIO_PinState stable_state = GPIO_PIN_SET;
    static uint32_t last_change_ms = 0U;
    GPIO_PinState sample = HAL_GPIO_ReadPin(BUTTON_PORT, BUTTON_PIN);

    if (sample != last_sample) {
        last_sample = sample;
        last_change_ms = now;
    }
    if ((uint32_t)(now - last_change_ms) >= BUTTON_DEBOUNCE_MS &&
        sample != stable_state) {
        stable_state = sample;
        if (stable_state == GPIO_PIN_RESET) {
            app.screen = (app.screen == SCREEN_CLOCK) ? SCREEN_SENSOR : SCREEN_CLOCK;
            app.display_dirty = 1U;
        }
    }
}

static void DHT_Task(uint32_t now)
{
    static uint32_t last_read_ms = 0U;
    uint8_t temp, hum;
    if ((uint32_t)(now - last_read_ms) < DHT_PERIOD_MS) return;
    last_read_ms = now;

    if (DHT11_Read(&temp, &hum) == HAL_OK) {
        if (!app.sensor_valid || temp != app.temperature || hum != app.humidity)
            app.display_dirty = 1U;
        app.temperature = temp;
        app.humidity = hum;
        app.sensor_valid = 1U;
    } else {
        if (app.sensor_valid) app.display_dirty = 1U;
        app.sensor_valid = 0U;
    }
}

static void Lamp_Task(uint32_t now)
{
    static uint32_t last_check_ms = 0U;
    static uint8_t first_run = 1U;
    ClockDateTime t;
    if (!first_run && (uint32_t)(now - last_check_ms) < LAMP_PERIOD_MS) return;
    first_run = 0U;
    last_check_ms = now;

    if (ClockRTC_Get(&t) != HAL_OK || t.hour >= 24U) {
        HAL_GPIO_WritePin(LAMP_PORT, LAMP_PIN, GPIO_PIN_RESET);
        return;
    }
    HAL_GPIO_WritePin(LAMP_PORT, LAMP_PIN,
        (t.hour >= 17U || t.hour < 5U) ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

static void Display_Task(uint32_t now)
{
    static uint32_t last_poll_ms = 0U;
    static char previous_line1[17] = "";
    static char previous_line2[17] = "";
    char line1[17] = {0};
    char line2[17] = {0};

    if (!app.display_dirty && (uint32_t)(now - last_poll_ms) < LCD_POLL_MS)
        return;
    last_poll_ms = now;

    if (app.screen == SCREEN_CLOCK) {
        ClockDateTime t;
        if (ClockRTC_Get(&t) == HAL_OK) {
            snprintf(line1, sizeof(line1), "TIME: %02u:%02u:%02u",
                (unsigned)(t.hour % 24U), (unsigned)(t.minute % 60U),
                (unsigned)(t.second % 60U));
            snprintf(line2, sizeof(line2), "DATE: %02u/%02u/%04u",
                (unsigned)(t.day % 100U), (unsigned)(t.month % 100U),
                (unsigned)(t.year % 10000U));
        } else {
            snprintf(line1, sizeof(line1), "RTC ERROR");
            snprintf(line2, sizeof(line2), "CHECK RTC");
        }
    } else if (app.sensor_valid) {
        snprintf(line1, sizeof(line1), "TEMP: %u C", (unsigned)app.temperature);
        snprintf(line2, sizeof(line2), "HUM : %u %%", (unsigned)app.humidity);
    } else {
        snprintf(line1, sizeof(line1), "DHT11 NO DATA");
        snprintf(line2, sizeof(line2), "CHECK PA10");
    }

    if (strcmp(line1, previous_line1) != 0) {
        LCD1602_WriteLine(0, line1);
        strcpy(previous_line1, line1);
    }
    if (strcmp(line2, previous_line2) != 0) {
        LCD1602_WriteLine(1, line2);
        strcpy(previous_line2, line2);
    }
    app.display_dirty = 0U;
}

void SystemClock_Config(void)
{
    RCC_OscInitTypeDef osc = {0};
    RCC_ClkInitTypeDef clk = {0};
    osc.OscillatorType = RCC_OSCILLATORTYPE_HSE;
    osc.HSEState = RCC_HSE_ON;
    osc.PLL.PLLState = RCC_PLL_ON;
    osc.PLL.PLLSource = RCC_PLLSOURCE_HSE;
    osc.PLL.PLLMUL = RCC_PLL_MUL9;
    if (HAL_RCC_OscConfig(&osc) != HAL_OK) Error_Handler();

    clk.ClockType = RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_SYSCLK |
                    RCC_CLOCKTYPE_PCLK1 | RCC_CLOCKTYPE_PCLK2;
    clk.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
    clk.AHBCLKDivider = RCC_SYSCLK_DIV1;
    clk.APB1CLKDivider = RCC_HCLK_DIV2;
    clk.APB2CLKDivider = RCC_HCLK_DIV1;
    if (HAL_RCC_ClockConfig(&clk, FLASH_LATENCY_2) != HAL_OK) Error_Handler();
}

static HAL_StatusTypeDef RTC_HSE128_Init(void)
{
    uint32_t start, prl;
    __HAL_RCC_PWR_CLK_ENABLE();
    __HAL_RCC_BKP_CLK_ENABLE();
    HAL_PWR_EnableBkUpAccess();

    if ((RCC->BDCR & RCC_BDCR_RTCSEL) != RCC_RTCCLKSOURCE_HSE_DIV128) {
        __HAL_RCC_BACKUPRESET_FORCE();
        __HAL_RCC_BACKUPRESET_RELEASE();
        HAL_PWR_EnableBkUpAccess();
    }
    __HAL_RCC_RTC_CONFIG(RCC_RTCCLKSOURCE_HSE_DIV128);
    __HAL_RCC_RTC_ENABLE();
    HAL_PWR_EnableBkUpAccess();

    CLEAR_BIT(RTC->CRL, RTC_CRL_RSF);
    start = HAL_GetTick();
    while ((RTC->CRL & RTC_CRL_RSF) == 0U) {
        if ((uint32_t)(HAL_GetTick() - start) > 2000U) return HAL_TIMEOUT;
    }
    start = HAL_GetTick();
    while ((RTC->CRL & RTC_CRL_RTOFF) == 0U) {
        if ((uint32_t)(HAL_GetTick() - start) > 2000U) return HAL_TIMEOUT;
    }

    prl = ((uint32_t)(RTC->PRLH & 0x0FU) << 16) | RTC->PRLL;
    if (prl != 62499U) {
        SET_BIT(RTC->CRL, RTC_CRL_CNF);
        RTC->PRLH = 0U;
        RTC->PRLL = 62499U;
        CLEAR_BIT(RTC->CRL, RTC_CRL_CNF);

        start = HAL_GetTick();
        while ((RTC->CRL & RTC_CRL_RTOFF) == 0U) {
            if ((uint32_t)(HAL_GetTick() - start) > 2000U) return HAL_TIMEOUT;
        }
    }
    return HAL_OK;
}

static void MX_GPIO_Init(void)
{
    GPIO_InitTypeDef p = {0};
    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_GPIOB_CLK_ENABLE();

    /* PA12 button, active LOW */
    p.Pin = BUTTON_PIN;
    p.Mode = GPIO_MODE_INPUT;
    p.Pull = GPIO_PULLUP;
    HAL_GPIO_Init(BUTTON_PORT, &p);

    /* PA10 DHT11: its driver may switch pin direction while reading */
    p.Pin = GPIO_PIN_10;
    p.Mode = GPIO_MODE_INPUT;
    p.Pull = GPIO_PULLUP;
    HAL_GPIO_Init(GPIOA, &p);

    /* PB11 L9110S IB: fixed LOW */
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_11, GPIO_PIN_RESET);
    p.Pin = GPIO_PIN_11;
    p.Mode = GPIO_MODE_OUTPUT_PP;
    p.Pull = GPIO_NOPULL;
    p.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(GPIOB, &p);

    /* PA11 lamp */
    HAL_GPIO_WritePin(LAMP_PORT, LAMP_PIN, GPIO_PIN_RESET);
    p.Pin = LAMP_PIN;
    p.Mode = GPIO_MODE_OUTPUT_PP;
    p.Pull = GPIO_NOPULL;
    p.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(LAMP_PORT, &p);
}

static void MX_I2C1_Init(void)
{
    GPIO_InitTypeDef p = {0};
    __HAL_RCC_GPIOB_CLK_ENABLE();
    __HAL_RCC_AFIO_CLK_ENABLE();
    __HAL_RCC_I2C1_CLK_ENABLE();

    __HAL_AFIO_REMAP_I2C1_ENABLE();
    p.Pin = GPIO_PIN_8 | GPIO_PIN_9;
    p.Mode = GPIO_MODE_AF_OD;
    p.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(GPIOB, &p);

    hi2c1.Instance = I2C1;
    hi2c1.Init.ClockSpeed = 100000U;
    hi2c1.Init.DutyCycle = I2C_DUTYCYCLE_2;
    hi2c1.Init.OwnAddress1 = 0U;
    hi2c1.Init.AddressingMode = I2C_ADDRESSINGMODE_7BIT;
    hi2c1.Init.DualAddressMode = I2C_DUALADDRESS_DISABLE;
    hi2c1.Init.OwnAddress2 = 0U;
    hi2c1.Init.GeneralCallMode = I2C_GENERALCALL_DISABLE;
    hi2c1.Init.NoStretchMode = I2C_NOSTRETCH_DISABLE;
    if (HAL_I2C_Init(&hi2c1) != HAL_OK) Error_Handler();
}

static void MX_TIM2_Init(void)
{
    GPIO_InitTypeDef p = {0};
    TIM_OC_InitTypeDef oc = {0};
    __HAL_RCC_TIM2_CLK_ENABLE();
    __HAL_RCC_GPIOB_CLK_ENABLE();
    __HAL_RCC_AFIO_CLK_ENABLE();

    /* TIM2_CH3 -> PB10 */
    __HAL_AFIO_REMAP_TIM2_PARTIAL_2();
    p.Pin = GPIO_PIN_10;
    p.Mode = GPIO_MODE_AF_PP;
    p.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(GPIOB, &p);

    htim2.Instance = TIM2;
    htim2.Init.Prescaler = 71U;
    htim2.Init.CounterMode = TIM_COUNTERMODE_UP;
    htim2.Init.Period = 999U;
    htim2.Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
    htim2.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_DISABLE;
    if (HAL_TIM_PWM_Init(&htim2) != HAL_OK) Error_Handler();

    oc.OCMode = TIM_OCMODE_PWM1;
    oc.Pulse = 0U;
    oc.OCPolarity = TIM_OCPOLARITY_HIGH;
    oc.OCFastMode = TIM_OCFAST_DISABLE;
    if (HAL_TIM_PWM_ConfigChannel(&htim2, &oc, TIM_CHANNEL_3) != HAL_OK)
        Error_Handler();
}

static void MX_TIM3_Init(void)
{
    GPIO_InitTypeDef p = {0};
    TIM_OC_InitTypeDef oc = {0};
    __HAL_RCC_TIM3_CLK_ENABLE();
    __HAL_RCC_GPIOB_CLK_ENABLE();
    __HAL_RCC_AFIO_CLK_ENABLE();

    /* Release PB4 from JTAG, retain SWD; TIM3 CH1 -> PB4 */
    __HAL_AFIO_REMAP_SWJ_NOJTAG();
    __HAL_AFIO_REMAP_TIM3_PARTIAL();
    p.Pin = GPIO_PIN_4;
    p.Mode = GPIO_MODE_AF_PP;
    p.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(GPIOB, &p);

    htim3.Instance = TIM3;
    htim3.Init.Prescaler = 71U;
    htim3.Init.CounterMode = TIM_COUNTERMODE_UP;
    htim3.Init.Period = 999U;
    htim3.Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
    htim3.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_DISABLE;
    if (HAL_TIM_PWM_Init(&htim3) != HAL_OK) Error_Handler();

    oc.OCMode = TIM_OCMODE_PWM1;
    oc.Pulse = 0U;
    oc.OCPolarity = TIM_OCPOLARITY_HIGH;
    oc.OCFastMode = TIM_OCFAST_DISABLE;
    if (HAL_TIM_PWM_ConfigChannel(&htim3, &oc, TIM_CHANNEL_1) != HAL_OK)
        Error_Handler();
    /* TIM3 reserved for another module: do NOT start PWM here. */
}

void Error_Handler(void)
{
    __disable_irq();
    HAL_GPIO_WritePin(LAMP_PORT, LAMP_PIN, GPIO_PIN_RESET);
    while (1) { }
}
